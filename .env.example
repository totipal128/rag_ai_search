DB_NAME=rag_example
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
REPORT_EMBEDDING_DIM=384

LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=all-minilm

# Opsional: provider embedding yang berbeda dari provider chat di atas
# (mis. chat lewat gateway multi-model, embedding tetap lewat Ollama karena
# tidak semua provider gateway mendukung endpoint /embeddings).
# Kalau dikosongkan, embedding ikut LLM_BASE_URL/LLM_API_KEY.
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama
